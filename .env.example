# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-5-5
CLAUDE_MAX_CALLS_PER_RUN=60

WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=1432080516647223
WHATSAPP_WABA_ID=1377545357487986
WHATSAPP_API_VERSION=v25.0
# Use hello_world until ade_alert is approved (check with: ade-radar check-template)
WHATSAPP_TEMPLATE=ade_alert
# Verify with check-template: may be en or en_US
WHATSAPP_TEMPLATE_LANG=en
# Comma separated, international format without +, max 5. Jack first.
WHATSAPP_RECIPIENTS=
# Comma separated, same order as WHATSAPP_RECIPIENTS; must match people in config/taste.yaml
RECIPIENT_NAMES=jack,friend1,friend2,friend3,friend4

GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
GMAIL_LABEL=ADE

# Long random string, backup channel for heartbeat/errors (subscribe in the ntfy app)
NTFY_TOPIC=

IG_PROFILE_DIR=data/ig_profile
